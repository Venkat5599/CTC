      "value": "91a1bab09799acf0928f391aa4306c2249268d97c9504224ea342d5c7c03355a",
      "type": "string",
      "description": "keccak256(\"AAVE_REPAYMENT\")"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helpers. `eth_call` returns one 32-byte word for every return",
          "// type used in this collection, so decoding is the same shape each time:",
          "// strip 0x, parse as hex. A revert comes back as an `error` object rather",
          "// than a short result, which is why every test checks for that first --",
          "// a reverted call that silently decoded to 0 would look like a real answer",
          "// of zero, and that is exactly the confusion this collection exists to end.",
          "pm.globals.set('decodeWord', '');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 · The proof exists",
      "description": "Before any benefit means anything, the fact has to be on chain.",
      "item": [
        {
          "name": "registry.totalProofs(subject) → 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "const value = parseInt(body.result, 16);",
                  "console.log('totalProofs =', value);",
                  "",
                  "pm.test('The subject has exactly one verified fact', () => {",
                  "    pm.expect(value).to.eql(1);",
                  "});",
                  "",
                  "pm.collectionVariables.set('provenTotal', value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{registry}}\",\n      \"data\": \"0x36d7db5f000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] },
            "description": "`totalProofs(address)`. One real Aave V3 repayment, proven from Sepolia through the Attestcoin Block Prover precompile and written to Creditcoin."
          }
        },
        {
          "name": "registry.hasProof(subject, AAVE_REPAYMENT) → true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "const isTrue = parseInt(body.result, 16) === 1;",
                  "pm.test('The fact is specifically an Aave repayment', () => {",
                  "    pm.expect(isTrue).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{registry}}\",\n      \"data\": \"0x349cf0d8000000000000000000000000{{subject}}{{factAaveRepayment}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] },
            "description": "`hasProof(address,bytes32)`. The primitive every Creditcoin application calls. Roughly 1,202 gas, flat, however long the history is."
          }
        },
        {
          "name": "registry.totalProofs(control) → 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('An unproven address has no standing', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(0);",
                  "});",
                  "",
                  "// Absence is not enumerable. The registry cannot prove somebody has a",
                  "// bad history, only that they have not proven a good one, which is why",
                  "// standing reduces collateral and never eliminates it."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{registry}}\",\n      \"data\": \"0x36d7db5f000000000000000000000000{{control}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        }
      ]
    },
    {
      "name": "2 · Four consumers, one fact",
      "description": "The thesis. Each of these contracts holds no privileged relationship with the registry: they call the same public view functions anyone can call. Run each against the proven subject and then against the control to see the benefit appear and disappear.",
      "item": [
        {
          "name": "passport.tierOf(subject) → 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('One proven repayment earns Tier 1', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{passport}}\",\n      \"data\": \"0xc8f74bb8000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] },
            "description": "Tier is derived from facts, never stored. It is monotonic by construction: no code path removes or decrements a fact, so a Vouch tier cannot fall."
          }
        },
        {
          "name": "credit.collateralBpsFor(subject) → 13000 (130%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "const bps = parseInt(body.result, 16);",
                  "console.log('collateral =', bps / 100 + '%');",
                  "",
                  "pm.test('Proven history cuts collateral from 150% to 130%', () => {",
                  "    pm.expect(bps).to.eql(13000);",
                  "});",
                  "",
                  "pm.test('Collateral never floors below 100%', () => {",
                  "    pm.expect(bps).to.be.at.least(10000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{credit}}\",\n      \"data\": \"0x85658f8a000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        },
        {
          "name": "credit.collateralBpsFor(control) → 15000 (150%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('An unproven address pays the full baseline', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(15000);",
                  "});",
                  "",
                  "// This is the request that makes the previous one mean something.",
                  "// A contract that quoted 130% to everybody would prove nothing at all."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{credit}}\",\n      \"data\": \"0x85658f8a000000000000000000000000{{control}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        },
        {
          "name": "receivables.advanceRateBpsFor(subject) → 8000 (80%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('An invoice advances at 80% instead of 70%', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(8000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{receivables}}\",\n      \"data\": \"0x8d5cf251000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] },
            "description": "The RWA consumer. A supplier financing an invoice draws a larger share of face value because their repayment history is proven rather than asserted."
          }
        },
        {
          "name": "receivables.advanceRateBpsFor(control) → 7000 (70%)",
          "event": [
