                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{access}}\",\n      \"data\": \"0xd233fb38000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        }
      ]
    },
    {
      "name": "3 · Standing does not leak",
      "description": "The subtlest claim in the project, and the one most worth checking. The exchange reads a different fact type, so a proven repayment must NOT move the trading fee. If this request returned anything other than the standard rate, the registry would be leaking standing between unrelated domains and every tier in it would be suspect.",
      "item": [
        {
          "name": "feeTier.feeBpsFor(subject) → 30 (0.30%, unchanged)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "const bps = parseInt(body.result, 16);",
                  "",
                  "pm.test('A repayment proof does NOT move the exchange fee', () => {",
                  "    pm.expect(bps).to.eql(30);",
                  "});",
                  "",
                  "// Same address, same registry, same run. Collateral moved and the fee",
                  "// did not, because they read different fact types. Standing is scoped",
                  "// to what was actually proven."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{feeTier}}\",\n      \"data\": \"0x2fc1c400000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        }
      ]
    },
    {
      "name": "4 · The registries, side by side",
      "description": "v1 is still on chain and its facts are still true. Nothing migrates a fact from one registry to another, which is why the v1 subject reads zero on v2 and the v2 subject reads zero on v1. Both requests are here so the history is legible rather than buried.",
      "item": [
        {
          "name": "v1.totalProofs(subject) → 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('Facts do not migrate between registries', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{registryV1}}\",\n      \"data\": \"0x36d7db5f000000000000000000000000{{subject}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] },
            "description": "The v2 subject has no standing on v1. Each registry is its own record; re-proving is how a fact reaches a new one."
          }
        }
      ]
    }
  ]
}
