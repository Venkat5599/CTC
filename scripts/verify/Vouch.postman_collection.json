                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('An unproven supplier draws the baseline 70%', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(7000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{receivables}}\",\n      \"data\": \"0x8d5cf251000000000000000000000000{{control}}\"\n    },\n    \"latest\"\n  ]\n}"
            },
            "url": { "raw": "{{rpc}}", "host": ["{{rpc}}"] }
          }
        },
        {
          "name": "access.isAdmitted(subject) → true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('RPC answered without an error', () => {",
                  "    pm.expect(body.error, JSON.stringify(body.error)).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('The gate opens for a proven address', () => {",
                  "    pm.expect(parseInt(body.result, 16)).to.eql(1);",
