# Creditcoin CC3 Testnet
CREDITCOIN_RPC=https://rpc.cc3-testnet.creditcoin.network

# Pays gas and grants no authority. The registry reads every subject from the
# proven log, so this key cannot claim standing for itself -- it can only stall
# or censor, and anyone can run a competing relayer if it does.
CREDITCOIN_PRIVATE_KEY=

# Source chain
ETH_MAINNET_RPC=
ETH_SEPOLIA_RPC=

# Attestcoin
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network

# chainKey is NOT chainId. On CC3 Testnet 1 is Sepolia and 3 is Ethereum
# mainnet; on CC3 Mainnet 1 is Ethereum mainnet. The wrong value does not
# throw -- it proves facts about a different chain.
ETH_MAINNET_CHAINKEY=3
ETH_SEPOLIA_CHAINKEY=1

# Persistence. Not authoritative: on-chain state is the truth and this is a
# work queue plus a cache. Dropping it loses no standing.
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch
REDIS_URL=redis://localhost:6379

# Deployed contracts. Left blank until Deploy.s.sol has run; consumers read a
# blank as "not deployed" rather than substituting a zero address, which would
# read as a contract that exists and answers false to everything.
VOUCH_REGISTRY_ADDRESS=
VOUCH_PASSPORT_ADDRESS=
VOUCH_CREDIT_ADDRESS=
VOUCH_FEE_TIER_ADDRESS=
VOUCH_ACCESS_ADDRESS=

# Frontend
NEXT_PUBLIC_ETH_RPC=
NEXT_PUBLIC_RELAYER_URL=
