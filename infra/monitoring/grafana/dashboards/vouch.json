{
  "uid": "vouch-overview",
  "title": "Vouch - pipeline",
  "tags": [
    "vouch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Facts verified (1h)",
      "type": "stat",
      "description": "Facts written to the registry in the last hour.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(vouch_facts_verified_total[1h]))",
          "legendFormat": "facts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Proofs per fact",
      "type": "stat",
      "description": "The number the batching argument turns on. 1.0 means every fact paid for its own continuity proof and batching bought nothing; 0.1 is a full batch.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vouch_proofs_per_fact",
          "legendFormat": "ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending claims",
      "type": "stat",
      "description": "Claims waiting for a batch. A backlog is latency, never loss.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vouch_queue_pending_claims",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stuck jobs",
      "type": "stat",
      "description": "Jobs that exhausted their retry budget. Kept rather than dropped so they stay visible; each one needs a human.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vouch_jobs_stuck",
          "legendFormat": "stuck",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Verification throughput",
      "type": "timeseries",
      "description": "Facts per second, by type.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(vouch_facts_verified_total[5m])) by (fact_type)",
          "legendFormat": "{{fact_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Batch fill (p50)",
      "type": "timeseries",
      "description": "Median claims per shipped batch. Falling toward 1 means the deadline is firing before batches fill, which is the batching saving evaporating.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vouch_batch_size_bucket[30m])) by (le))",
          "legendFormat": "p50 claims",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Source freshness",
      "type": "timeseries",
      "description": "Seconds since the last fact from each source. The most important panel here: a wrong topic0, emitter or chainKey all present as permanent silence, indistinguishable from a quiet protocol.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - vouch_source_last_fact_timestamp_seconds",
          "legendFormat": "{{fact_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Indexer lag",
      "type": "timeseries",
      "description": "Blocks behind the confirmed head. The cursor never advances past a confirmation backoff, so some lag is by design.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "vouch_indexer_blocks_behind",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Settlement outcomes",
      "type": "timeseries",
      "description": "A rejected outcome means the claim can never land. An already-verified outcome is a SUCCESS: someone else submitted the proof first, which is what permissionless submission means.",
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(vouch_settlement_total[15m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
